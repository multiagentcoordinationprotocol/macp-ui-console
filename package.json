{
  "name": "macp-ui-console",
  "version": "0.2.1",
  "private": true,
  "description": "Feature-rich Next.js orchestration and observability console for MACP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "dev:demo": "NEXT_PUBLIC_MACP_UI_DEMO_MODE=true next dev",
    "dev:real": "NEXT_PUBLIC_MACP_UI_DEMO_MODE=false next dev",
    "dev:e2e": "npx env-cmd -f .env.e2e next dev",
    "local:up": "./scripts/local-stack.sh up",
    "local:down": "./scripts/local-stack.sh down",
    "local:status": "./scripts/local-stack.sh status"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.64.0",
    "macp-sdk-typescript": "0.21.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.1.0",
    "vitest": "^5.0.5"
  }
}
